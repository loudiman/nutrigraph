# Copy to .env. Compose and both services read it.

# Host port for the compose PostgreSQL. Change it if 5432 is already taken.
POSTGRES_PORT=5432

DATABASE_URL=postgresql://nutrigraph:nutrigraph@localhost:5432/nutrigraph

# --- agent ---
AGENT_HOST=127.0.0.1
AGENT_PORT=8080
# Local only. Production never sets this: it authenticates the gateway with a
# Google-signed Cloud Run identity token instead. The agent refuses to start
# when this is set together with a non-loopback AGENT_HOST.
AGENT_DEV_AUTH=1
AGENT_DEV_TOKEN=local-development

# --- models ---
# The provider is a configuration string, not a code path. To move every model
# call to another vendor, change these three lines and install that vendor's
# LangChain package: `openai` with gpt-5-mini / gpt-5, or `anthropic` with
# claude-haiku-4-5 / claude-sonnet-5. Nothing in the codebase branches on the
# vendor, so there is no dead code behind the swap.
MODEL_PROVIDER=google_genai
# Work that fills a fixed schema from text.
MODEL_SCHEMA=gemini-3.5-flash-lite
# Work that reasons or writes prose for the User.
MODEL_PROSE=gemini-3.5-flash
# The Corpus index and the query that searches it. Changing it re-ingests the
# whole Corpus; changing the dimension count re-indexes it (ADR 0001).
MODEL_EMBEDDING=gemini-embedding-001
# Read by LangChain, never by this codebase. Rename it for another provider
# (OPENAI_API_KEY, ANTHROPIC_API_KEY).
GOOGLE_API_KEY=

# --- tracing ---
# These two switch LangSmith on. No code change: every node becomes a nested run
# under the Turn. LangSmith is the reading tool; `interaction_event` is the
# record, because the free tier keeps traces for 14 days.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nutrigraph

# --- gateway ---
GATEWAY_PORT=3000
SESSION_SECRET=local-development-cookie-secret
AGENT_URL=http://127.0.0.1:8080
DEMO_USER_ID=demo-user-1
